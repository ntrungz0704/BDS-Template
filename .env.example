# Database Config (PostgreSQL via Docker Compose)
DATABASE_URL="postgresql://postgres:securepassword@localhost:5432/real_estate_platform?schema=public&connection_limit=20&pool_timeout=20"

# Node Environment
NODE_ENV="development"
PORT=5000

# Security (JWT) - generate two different values, for example with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Auth and tenant URLs
FRONTEND_URL="http://localhost:3000"
CMS_URL="http://localhost:3001"
PLATFORM_DOMAIN="localhost"
INTERNAL_API_TOKEN=""
COOKIE_DOMAIN=""
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003"

# Cloudinary Integration (Media storage)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email SMTP Config (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="no-reply@myplatform.com"

# Explicit development seed credentials (required only when running seed)
SEED_ADMIN_PASSWORD=""
SEED_CUSTOMER_PASSWORD=""
ALLOW_AUTO_SEED="false"
