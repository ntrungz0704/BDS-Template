datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  TENANT_EDITOR
}

enum OrderStatus {
  PENDING
  PENDING_SUBDOMAIN_CONFLICT
  AWAITING_MANUAL_REVIEW
  WAITING_CONFIRM
  COMPLETED
  REJECTED
}

enum ProjectStatus {
  COMING_SOON
  SELLING
  SOLD_OUT
}

enum ProjectType {
  APARTMENT
  VILLA
  TOWNHOUSE
  LAND
  COMMERCIAL
  OFFICE
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String         @map("password_hash")
  fullName     String         @map("full_name")
  phone        String?
  avatar       String?
  role         UserRole       @default(TENANT_ADMIN)
  tenantId     String?        @map("tenant_id")
  tenant       Tenant?        @relation("TenantUsers", fields: [tenantId], references: [id], onDelete: SetNull)
  isActive     Boolean        @default(true) @map("is_active")
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([email])
  @@index([tenantId])
  @@index([role])
  @@map("users")
}

model Tenant {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  domain          String?        @unique
  status          String         @default("ACTIVE") // ACTIVE, SUSPENDED
  templateId      String?        @map("template_id")
  template        Template?      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  themeOverrides  Json?          @map("theme_overrides") // CSS Variables override
  activatedAt     DateTime?      @map("activated_at")
  expiresAt       DateTime?      @map("expires_at")
  uploadUsedBytes BigInt         @default(0) @map("upload_used_bytes")
  version         Int            @default(1)
  deletedAt       DateTime?      @map("deleted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  users           User[]         @relation("TenantUsers")
  projects        Project[]
  posts           Post[]
  banners         Banner[]
  menus           Menu[]
  categories      Category[]
  tags            Tag[]
  media           Media[]
  contactFormSubmissions ContactFormSubmission[]
  companyInfo     CompanyInfo?
  seoConfig       SeoConfig?
  subscription    Subscription?

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@map("tenants")
}

model Template {
  id                String          @id @default(cuid())
  name              String
  slug              String          @unique
  description       String?
  shortDescription  String?         @map("short_description")
  thumbnail         String?
  screenshots       Json?           @default("[]")
  features          Json?           @default("[]")
  priceBuy          Int?            @map("price_buy")
  priceRentMonthly  Int?            @map("price_rent_monthly")
  isActive          Boolean         @default(true) @map("is_active")
  sortOrder         Int             @default(0) @map("sort_order")
  deletedAt         DateTime?       @map("deleted_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  tenants           Tenant[]
  orders            Order[]
  demoSessions      DemoSession[]
  templateConfig    TemplateConfig?

  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@map("templates")
}

model TemplateConfig {
  id           String   @id @default(cuid())
  templateId   String   @unique @map("template_id")
  template     Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  themeConfig  Json     @map("theme_config") // Default colors, typography
  layoutConfig Json     @map("layout_config") // Structure sections config
  featureFlags Json     @map("feature_flags") // Enabled pages config
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("template_configs")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique @map("order_number")
  fullName        String      @map("full_name")
  email           String
  phone           String
  note            String?
  subdomain       String?     @map("subdomain") // Đăng ký subdomain cho đơn thuê
  type            String      // BUY, RENT
  status          OrderStatus @default(PENDING)
  templateId      String      @map("template_id")
  template        Template    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  userId          String?     @map("user_id")
  tenantId        String?     @map("tenant_id")
  plan            String?     // BASIC, PRO, PREMIUM
  amount          Int?
  paidAt          DateTime?   @map("paid_at")
  billImageUrl    String?     @map("bill_image_url")
  transactionCode String?     @unique @map("transaction_code")
  adminNotes      String?     @map("admin_notes")
  version         Int         @default(1)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model Subscription {
  id          String    @id @default(cuid())
  tenantId    String    @unique @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId     String?   @map("order_id")
  plan        String    // BASIC, PRO, PREMIUM
  status      String    @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  amount      Int
  startDate   DateTime  @map("start_date")
  endDate     DateTime  @map("end_date")
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model Project {
  id               String        @id @default(cuid())
  tenantId         String        @map("tenant_id")
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title            String
  slug             String
  description      String?
  shortDescription String?       @map("short_description")
  type             ProjectType   @default(APARTMENT)
  status           ProjectStatus @default(SELLING)
  price            String?
  priceFrom        BigInt?       @map("price_from")
  priceTo          BigInt?       @map("price_to")
  area             String?
  areaFrom         Float?        @map("area_from")
  areaTo           Float?        @map("area_to")
  address          String?
  ward             String?
  district         String?
  city             String?
  latitude         Float?
  longitude        Float?
  investor         String?
  developer        String?
  constructionYear Int?          @map("construction_year")
  handoverDate     String?       @map("handover_date")
  totalUnits       Int?          @map("total_units")
  amenities        Json?         @default("[]")
  images           Json?         @default("[]")
  thumbnail        String?
  floorPlans       Json?         @default("[]") @map("floor_plans")
  documents        Json?         @default("[]")
  youtubeUrl       String?       @map("youtube_url")
  virtualTourUrl   String?       @map("virtual_tour_url")
  featured         Boolean       @default(false)
  sortOrder        Int           @default(0) @map("sort_order")
  seoTitle         String?       @map("seo_title")
  seoDescription   String?       @map("seo_description")
  seoKeywords      String?       @map("seo_keywords")
  published        Boolean       @default(false)
  publishedAt      DateTime?     @map("published_at")
  version          Int           @default(1)
  deletedAt        DateTime?     @map("deleted_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  tags             Tag[]         @relation("ProjectTags")

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, published])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("projects")
}

model Post {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  content     String?
  summary     String?
  thumbnail   String?
  categoryId  String?   @map("category_id")
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  published   Boolean   @default(false)
  publishedAt DateTime? @map("published_at")
  version     Int       @default(1)
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  tags        Tag[]     @relation("PostTags")

  @@unique([tenantId, slug])
  @@index([tenantId, published])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("posts")
}

model Category {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  posts       Post[]

  @@unique([tenantId, slug])
  @@map("categories")
}

model Tag {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  createdAt DateTime  @default(now()) @map("created_at")
  posts     Post[]    @relation("PostTags")
  projects  Project[] @relation("ProjectTags")

  @@unique([tenantId, slug])
  @@map("tags")
}

model Banner {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title      String
  subtitle   String?
  imageUrl   String    @map("image_url")
  actionUrl  String?   @map("action_url")
  actionText String?   @map("action_text")
  sortOrder  Int       @default(0) @map("sort_order")
  isActive   Boolean   @default(true) @map("is_active")
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, isActive, sortOrder])
  @@map("banners")
}

model Menu {
  id        String     @id @default(cuid())
  tenantId  String     @map("tenant_id")
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  location  String     @default("header") // header, footer
  isActive  Boolean    @default(true) @map("is_active")
  version   Int        @default(1)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  menuItems MenuItem[]

  @@unique([tenantId, location])
  @@map("menus")
}

model MenuItem {
  id        String     @id @default(cuid())
  menuId    String     @map("menu_id")
  menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId  String?    @map("parent_id")
  parent    MenuItem?  @relation("MenuSubItems", fields: [parentId], references: [id], onDelete: Cascade)
  label     String
  url       String
  target    String     @default("_self")
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  subItems  MenuItem[] @relation("MenuSubItems")

  @@index([menuId])
  @@index([parentId])
  @@map("menu_items")
}

model CompanyInfo {
  id               String   @id @default(cuid())
  tenantId         String   @unique @map("tenant_id")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String?
  description      String?
  aboutContent     String?  @map("about_content")
  logo             String?
  favicon          String?
  slogan           String?
  phone            String?
  hotline          String?
  email            String?
  address          String?
  googleMapsEmbed  String?  @map("google_maps_embed")
  facebook         String?
  zalo             String?
  youtube          String?
  tiktok           String?
  workingHours     String?  @map("working_hours")
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("company_infos")
}

model SeoConfig {
  id                  String   @id @default(cuid())
  tenantId            String   @unique @map("tenant_id")
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metaTitle           String?  @map("meta_title")
  metaDescription     String?  @map("meta_description")
  ogImage             String?  @map("og_image")
  googleAnalyticsId   String?  @map("google_analytics_id")
  googleSearchConsole String?  @map("google_search_console")
  robotsTxt           String?  @map("robots_txt")
  enableSitemap       Boolean  @default(true) @map("enable_sitemap")
  version             Int      @default(1)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("seo_configs")
}

model Media {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  filename  String
  url       String
  publicId  String    @map("public_id")
  mimeType  String    @map("mime_type")
  fileSize  Int       @map("file_size")
  width     Int?
  height    Int?
  alt       String?
  folder    String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("media")
}

model ContactFormSubmission {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fullName  String    @map("full_name")
  email     String
  phone     String
  message   String
  source    String?   // e.g. "project_detail_grand_riverside"
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("contact_form_submissions")
}

model DemoSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  templateId   String   @map("template_id")
  template     Template @relation(fields: [templateId], references: [id], onDelete: Restrict)
  customData   Json?    @map("custom_data") // Custom settings stored
  saveCount    Int      @default(0) @map("save_count")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("demo_sessions")
}

model RefreshToken {
  id               String    @id @default(cuid())
  token            String    @unique
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt        DateTime  @map("expires_at")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  revokedAt        DateTime? @map("revoked_at")
  replacedByToken  String?   @map("replaced_by_token")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenantId   String?  @map("tenant_id")
  action     String   // e.g. "CREATE_PROJECT"
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
