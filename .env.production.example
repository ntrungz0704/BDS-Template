# ==============================================================================
# ENVIRONMENT VARIABLES - PRODUCTION (.env.production)
# ==============================================================================
# Sao chép file này thành .env hoặc .env.production trên máy chủ VPS/Cloud
# Lệnh: cp .env.production.example .env

# --- CẤU HÌNH NODE & PORT ---
NODE_ENV=production

# --- CẤU HÌNH DOMAIN & CORS PRODUCTION ---
NEXT_PUBLIC_DOMAIN=aireviewbds.com
NEXT_PUBLIC_API_URL=https://api.aireviewbds.com
NEXT_PUBLIC_PLATFORM_DOMAIN=templates.aireviewbds.com
PLATFORM_DOMAIN=templates.aireviewbds.com
COOKIE_DOMAIN=.aireviewbds.com
CORS_ORIGINS=https://aireviewbds.com,https://www.aireviewbds.com,https://templates.aireviewbds.com,https://cms.aireviewbds.com,https://admin.aireviewbds.com

# --- CẤU HÌNH DATABASE POSTGRESQL ---
POSTGRES_USER=postgres_prod_user
POSTGRES_PASSWORD=StrongSecurePasswordProduction2026!
POSTGRES_DB=aireviewbds_prod_db


# DATABASE_URL cho Prisma trong container app-api (dùng internal DNS: app-postgres)
DATABASE_URL="postgresql://postgres_prod_user:StrongSecurePasswordProduction2026!@app-postgres:5432/aireviewbds_prod_db?schema=public"


# --- BẢO MẬT & JWT (Thay bằng chuỗi ngẫu nhiên dài và an toàn) ---
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="7d"

# --- CẤU HÌNH REDIS & PGBOUNCER (PHASE 2) ---
REDIS_PASSWORD="StrongRedisPassword2026!"
REDIS_URL="redis://:StrongRedisPassword2026!@app-redis:6379"
# Khi dùng PgBouncer ở Phase 2, đổi port 5432 sang 6432 và host sang app-pgbouncer:
# DATABASE_URL="postgresql://postgres_prod_user:StrongSecurePasswordProduction2026!@app-pgbouncer:6432/platformbds_prod_db?schema=public&pgbouncer=true"

# --- CẤU HÌNH EMAIL / SMS / CLOUDINARY (Tùy chọn) ---
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@platformbds.vn
SMTP_PASS=
SMTP_FROM="PlatformBDS <no-reply@platformbds.vn>"
FRONTEND_URL=https://platformbds.vn
CMS_URL=https://cms.platformbds.vn
INTERNAL_API_TOKEN=
# CLOUDINARY_CLOUD_NAME=platformbds
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12345
# Required: random secret configured identically in SePay's webhook settings.
SEPAY_WEBHOOK_SECRET=replace-with-a-long-random-secret
